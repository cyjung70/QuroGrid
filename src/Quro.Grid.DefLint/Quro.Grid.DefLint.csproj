<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quro-deflint</ToolCommandName>
    <Description>QuroGrid screen definition (TOON) lint for CI: checks every *.screen.toon under a folder. Usage: quro-deflint &lt;folder&gt; [--catalog catalog.json]</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quro.Grid.Definition.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quro.Grid.Definition\Quro.Grid.Definition.csproj" />
  </ItemGroup>

</Project>
