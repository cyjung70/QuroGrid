@typeparam TItem where TItem : class
@attribute [CascadingTypeParameter(nameof(TItem))]
@implements IColumnHost
@implements IAsyncDisposable

<CascadingValue TValue="IColumnHost" Value="this" IsFixed="true">@ChildContent</CascadingValue>

@if (ConfirmLeave)
{
    @* 미저장 변경 이탈 확인 (R7, Addendum A-20): 창 닫기·새로고침은 브라우저 경고, 앱 안 이동은 확인창 *@
    <NavigationLock ConfirmExternalNavigation="DataSet.HasChanges" OnBeforeInternalNavigation="ConfirmInternalNavigation" />
}

@* 컬럼 정의가 등록된 뒤에 그린다. 셀 단위 이벤트 핸들러를 두지 않는다 (R5): 클릭·키는 quro-grid.js가 좌표로 해석한다. *@
<Deferred>
    @{ var bodyRows = BodyRowCount(); var headerRows = HeaderRows; }
    <div @ref="_root" class="@(Paging ? "quro-grid quro-paged" : "quro-grid")" style="@RootStyle"
         role="grid" tabindex="0" aria-colcount="@Columns.Count"
         aria-rowcount="@(headerRows + bodyRows + (ShowFooter ? 1 : 0))" data-header-rows="@headerRows"
         data-dirty="@(DataSet.HasChanges ? "true" : null)"
         data-leave-message="@(ConfirmLeave ? Text(GridKeys.LeaveUnsaved) : null)">
        @* 연결 끊김 중에는 서버가 그릴 수 없으므로 안내를 미리 그려 두고 quro-grid.js가 보이게 한다 (R7, A-21) *@
        <div class="quro-notice quro-notice-offline" role="alert">
            @Text(GridKeys.ConnectionOffline)
            <span class="quro-notice-unsaved">@Text(GridKeys.ConnectionUnsaved)</span>
        </div>
        <div class="quro-notice quro-notice-lost" role="alert">@Text(GridKeys.ChangesLost)</div>
        <div class="quro-head" role="rowgroup">
            @for (var level = 0; level < headerRows - 1; level++)
            {
                @* 다단 헤더 (GS-070): 그룹 칸은 묶인 컬럼 너비의 합. 클릭·드래그는 받지 않는다 (data-field 없음) *@
                <div class="quro-row quro-group-row" role="row" aria-rowindex="@(level + 1)">
                    @foreach (var g in GroupCells(level))
                    {
                        if (g.Group is null)
                        {
                            <div class="@g.Class" style="@g.Style" role="columnheader" aria-colindex="@(g.First + 1)"></div>
                        }
                        else
                        {
                            <div class="@g.Class" style="@g.Style" role="columnheader" aria-colindex="@(g.First + 1)"
                                 aria-colspan="@g.Count">@Text(g.Group.HeaderKey)</div>
                        }
                    }
                </div>
            }
            <div class="quro-row" role="row" aria-rowindex="@headerRows">
                @for (var i = 0; i < Columns.Count; i++)
                {
                    var col = Columns[i];
                    var sort = SortOf(col);
                    @* 헤더 클릭(정렬)·경계 드래그(리사이즈)·필터 버튼은 quro-grid.js가 받는다 (R5, A-22·A-23·A-31) *@
                    <div class="@CellClass(i, "quro-header")" style="@CellStyle(i)" role="columnheader"
                         aria-colindex="@(i + 1)" data-field="@col.Field" aria-sort="@AriaSort(sort)"
                         data-filtered="@(FilterOf(col) is null ? null : "true")">@Text(col.HeaderKey)@if (sort is not null)
                         {<span class="quro-sort" aria-hidden="true" data-dir="@(sort.Direction == SortDirection.Ascending ? "asc" : "desc")" data-order="@SortOrder(col)"></span>}@if (col.Type != CellType.Button)
                         {<span class="quro-filter-button" role="button" aria-label="@Text(GridKeys.FilterOpen)"></span>}<span class="quro-resize" aria-hidden="true"></span></div>
                }
            </div>
        </div>

        @if (FilterColumn is { } filterCol)
        {
            @* 필터 패널 (A-31): 입력은 브라우저에서만, 적용·해제·Esc는 quro-grid.js가 1회 호출한다 (R2). 위치는 JS가 헤더 아래로 *@
            var draft = FilterDraft(filterCol);
            <div class="quro-filter-panel" role="dialog" aria-label="@Text(filterCol.HeaderKey)" data-field="@filterCol.Field">
                @switch (FilterKind(filterCol))
                {
                    case "number":
                        <input class="quro-filter-input" data-filter="min" inputmode="decimal" value="@draft.Min"
                               placeholder="@Text(GridKeys.FilterMin)" aria-label="@Text(GridKeys.FilterMin)" aria-invalid="@FilterInvalid("min")" />
                        <input class="quro-filter-input" data-filter="max" inputmode="decimal" value="@draft.Max"
                               placeholder="@Text(GridKeys.FilterMax)" aria-label="@Text(GridKeys.FilterMax)" aria-invalid="@FilterInvalid("max")" />
                        break;
                    case "date":
                        <input class="quro-filter-input" type="date" data-filter="from" value="@draft.From"
                               aria-label="@Text(GridKeys.FilterFrom)" aria-invalid="@FilterInvalid("from")" />
                        <input class="quro-filter-input" type="date" data-filter="to" value="@draft.To"
                               aria-label="@Text(GridKeys.FilterTo)" aria-invalid="@FilterInvalid("to")" />
                        break;
                    case "values":
                        @foreach (var option in FilterValues(filterCol))
                        {
                            <label class="quro-filter-option">
                                <input type="checkbox" data-filter="value" value="@option.Value"
                                       checked="@(draft.Values?.Contains(option.Value) ?? true)" />@option.Text
                            </label>
                        }
                        break;
                    default:
                        <input class="quro-filter-input" data-filter="text" value="@draft.Text"
                               placeholder="@Text(GridKeys.FilterContains)" aria-label="@Text(GridKeys.FilterContains)" />
                        break;
                }
                <div class="quro-filter-actions">
                    <button type="button" data-filter-action="clear">@Text(GridKeys.FilterClear)</button>
                    <button type="button" data-filter-action="apply">@Text(GridKeys.FilterApply)</button>
                </div>
            </div>
        }

        <div class="quro-body" role="rowgroup">
            @if (Paging)
            {
                @* 서버측 페이징 (R6, A-24): 보이는 범위만 그리고 적재한다. 삭제 표시 행은 자리에 남아 취소선 *@
                <Virtualize @ref="_virtualize" TItem="int" ItemsProvider="ProvideRows" ItemSize="RowHeight" OverscanCount="10"
                            Context="key">
                    <ItemContent>
                        <QuroGridRow @key="key" TItem="TItem" Grid="this" RowKey="key" RowIndex="RowIndexOf(key)"
                                     Revision="DataSet.GetRevision(key)" Epoch="_epoch"
                                     EditingField="@(_editing?.RowKey == key ? _editing.Value.Field : null)"
                                     PickerOpen="IsPickerOpen(key)" />
                    </ItemContent>
                    <Placeholder><div class="quro-row quro-placeholder"></div></Placeholder>
                </Virtualize>
            }
            else
            {
                var index = 0;
                foreach (var key in VisibleRowKeys())
                {
                    <QuroGridRow @key="key" TItem="TItem" Grid="this" RowKey="key" RowIndex="index++"
                                 Revision="DataSet.GetRevision(key)" Epoch="_epoch"
                                 EditingField="@(_editing?.RowKey == key ? _editing.Value.Field : null)"
                                 PickerOpen="IsPickerOpen(key)" />
                }
            }
        </div>

        @if (ShowFooter)
        {
            <div class="quro-foot" role="rowgroup">
                <div class="quro-row quro-footer-row" role="row" aria-rowindex="@(headerRows + bodyRows + 1)">
                    @for (var i = 0; i < Columns.Count; i++)
                    {
                        var col = Columns[i];
                        <div class="@CellClass(i, "quro-footer")" style="@CellStyle(i)" role="gridcell"
                             aria-colindex="@(i + 1)" data-footer-field="@col.Field">@FooterText(col)</div>
                    }
                </div>
            </div>
        }
    </div>
</Deferred>
