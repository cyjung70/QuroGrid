@typeparam TItem where TItem : class

@{
    var deleted = Grid.DataSet.GetState(RowKey) == RowState.Deleted;
}
<div class="@("quro-row" + (deleted ? " quro-deleted" : "") + (Locked ? " quro-row-readonly" : ""))" role="row" data-row="@RowKey" aria-rowindex="@(RowIndex + Grid.HeaderRows + 1)"
     aria-level="@(Level > 0 ? Level : null)" aria-expanded="@(Expanded is { } open ? (open ? "true" : "false") : null)">
    @if (Grid.ShowRowNumbers)
    {
        @* display only (GS-100): no data-field, so quro-grid.js never selects, copies or moves onto it *@
        <div class="quro-cell quro-row-number quro-frozen" role="rowheader" aria-colindex="1">@Number</div>
    }
    @if (Grid.ShowRowState)
    {
        @* display only (GS-106): no data-field, so quro-grid.js never selects, copies or moves onto it. The symbol comes from CSS *@
        var state = Grid.DataSet.GetState(RowKey);
        <div class="quro-cell quro-row-state quro-frozen" role="gridcell" aria-colindex="@Grid.RowStateColIndex"
             data-state="@Grid.RowStateName(state)" title="@Grid.RowStateText(state)" aria-label="@Grid.RowStateText(state)"></div>
    }
    @for (var i = 0; i < Grid.Columns.Count; i++)
    {
        var col = Grid.Columns[i];
        var mark = Grid.Mark(RowKey, col);
        var treeCell = Level > 0 && Grid.IsTreeCell(col);
        <div class="@(MarkClass(Grid.CellClass(i, "quro-body-cell"), mark) + Grid.ToneClass(RowKey, col) + Grid.AlignClass(col) + Grid.MergeClass(Merge, i) + (treeCell ? " quro-tree-cell" : ""))"
             style="@(Grid.CellStyle(i) + (treeCell ? $";--qg-tree-level:{Level - 1}" : ""))" role="gridcell"
             aria-colindex="@Grid.ColIndex(i)" data-field="@col.Field" data-type="@Grid.TypeAttribute(col)"
             data-copy="@Grid.CopyText(RowKey, col)" data-edit="@Grid.EditAttribute(RowKey, col)" data-mask="@(Grid.EditOnSelect ? col.Mask : null)"
             aria-readonly="@(Grid.CellReadOnly(RowKey, col) ? "true" : null)"
             aria-invalid="@(mark?.Level == CellMarkLevel.Error ? "true" : null)"
             title="@(mark is null ? null : Grid.Text(mark.MessageKey))">
            @if (treeCell && Expanded is not null && EditingField != col.Field)
            {
                @* the glyph comes from CSS: quro-grid.js reads the cell text for editors and copy (GS-104). The click is received on the grid (R5) *@
                <span class="quro-tree-toggle" aria-hidden="true"></span>
            }
            @if (EditingField == col.Field)
            {
                @* 키 입력은 브라우저에서만 처리한다 (R2). 값은 quro-grid.js가 셀 이탈 시 CommitEdit로 1회 보낸다. *@
                <input class="quro-editor" value="@Grid.EditText(RowKey, col)" data-mask="@col.Mask" />
                @if (PickerOpen)
                {
                    @* 선택 목록 (Addendum A-17): 고르면 바로 확정. 편집 중인 셀 하나에만 있다. *@
                    <div class="quro-picker">
                        @if (col.Type == CellType.Date)
                        {
                            @* 달력은 quro-grid.js가 그린다 (A-67). 달을 넘기는 동안 서버 호출이 없고, 고른 날짜만 PickDate로 1회 *@
                            <div class="quro-calendar" data-iso="@Grid.PickerIso" data-culture="@Grid.EffectiveCulture.Name"
                                 data-firstday="@((int)Grid.EffectiveCulture.DateTimeFormat.FirstDayOfWeek)"></div>
                        }
                        else
                        {
                            @* 현재 값은 선택 표시만. 같은 항목을 다시 골라도 확정된다. 항목 클릭은 quro-grid.js가 받아 PickOption으로 1회 (R5) *@
                            var selected = Grid.PickerIndex(col);
                            var options = Grid.OptionsOf(col, RowKey) ?? [];
                            <ul class="quro-options" role="listbox">
                                @for (var o = 0; o < options.Count; o++)
                                {
                                    <li class="quro-option" role="option" data-index="@o" aria-selected="@(o == selected ? "true" : null)">@options[o].Text</li>
                                }
                            </ul>
                        }
                    </div>
                }
            }
            else if (col.Type == CellType.Check)
            {
                <span class="quro-check" role="checkbox" aria-checked="@(Grid.IsChecked(RowKey, col) ? "true" : "false")"></span>
            }
            else if (col.Type == CellType.Image)
            {
                @if (Grid.ImageUrl(RowKey, col) is { } url)
                {
                    @* the click is received by quro-grid.js on the grid (R5) and sent once as ClickCell *@
                    <img class="quro-image" src="@url" alt="@Grid.ImageAlt(RowKey, col)" />
                }
            }
            else if (col.Type == CellType.Button)
            {
                <span class="quro-button" role="button">@Grid.Text(col.TextKey ?? "")</span>
            }
            else
            {
                @Grid.DisplayText(RowKey, col)
            }
        </div>
    }
</div>

@code {
    private (int Revision, int Epoch, int RowIndex, int Number, bool Locked, string? EditingField, bool PickerOpen, int Level, bool? Expanded, string? Merge)? _rendered;

    [Parameter, EditorRequired] public QuroGrid<TItem> Grid { get; set; } = default!;
    [Parameter, EditorRequired] public int RowKey { get; set; }
    [Parameter] public int RowIndex { get; set; }
    [Parameter] public int Revision { get; set; }
    [Parameter] public int Epoch { get; set; }
    /// <summary>The app's RowReadOnly function locks this row (GS-099). A lock can change without a value change, so it is in the render key.</summary>
    [Parameter] public bool Locked { get; set; }
    /// <summary>Row number (GS-100); 0 when the option is off. Grouping can change it while the row keeps other inputs, so it is in the render key.</summary>
    [Parameter] public int Number { get; set; }
    /// <summary>Tree level, 1 at the root (GS-104); 0 when the grid is not a tree.</summary>
    [Parameter] public int Level { get; set; }
    /// <summary>Whether the row's children show (GS-104); null when it has none.</summary>
    [Parameter] public bool? Expanded { get; set; }
    /// <summary>The merge state of each column (GS-110), or null. A neighbor's edit can change it, so it is in the render key.</summary>
    [Parameter] public string? Merge { get; set; }
    [Parameter] public string? EditingField { get; set; }
    [Parameter] public bool PickerOpen { get; set; }

    /// <summary>행 단위 렌더 (R4): 행 리비전·편집 셀·선택 목록·위치·그리드 epoch가 바뀐 행만 다시 그린다.</summary>
    protected override bool ShouldRender()
    {
        var now = (Revision, Epoch, RowIndex, Number, Locked, EditingField, PickerOpen, Level, Expanded, Merge);
        if (_rendered == now)
            return false;
        _rendered = now;
        return true;
    }

    // 첫 렌더는 ShouldRender를 거치지 않으므로 여기서 기록한다.
    protected override void OnInitialized() => _rendered = (Revision, Epoch, RowIndex, Number, Locked, EditingField, PickerOpen, Level, Expanded, Merge);

    private static string MarkClass(string cls, CellMark? mark) => mark?.Level switch
    {
        CellMarkLevel.Error => cls + " quro-mark-error",
        CellMarkLevel.Warning => cls + " quro-mark-warning",
        _ => cls,
    };
}
