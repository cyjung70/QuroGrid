@typeparam TItem where TItem : class

@{
    var deleted = Grid.DataSet.GetState(RowKey) == RowState.Deleted;
}
<div class="@(deleted ? "quro-row quro-deleted" : "quro-row")" role="row" data-row="@RowKey" aria-rowindex="@(RowIndex + Grid.HeaderRows + 1)">
    @for (var i = 0; i < Grid.Columns.Count; i++)
    {
        var col = Grid.Columns[i];
        var mark = Grid.Mark(RowKey, col);
        <div class="@(MarkClass(Grid.CellClass(i, "quro-body-cell"), mark) + Grid.ToneClass(RowKey, col))" style="@Grid.CellStyle(i)" role="gridcell"
             aria-colindex="@(i + 1)" data-field="@col.Field" data-type="@Grid.TypeAttribute(col)"
             data-copy="@Grid.CopyText(RowKey, col)"
             aria-readonly="@(Grid.CellReadOnly(RowKey, col) ? "true" : null)"
             aria-invalid="@(mark?.Level == CellMarkLevel.Error ? "true" : null)"
             title="@(mark is null ? null : Grid.Text(mark.MessageKey))">
            @if (EditingField == col.Field)
            {
                @* 키 입력은 브라우저에서만 처리한다 (R2). 값은 quro-grid.js가 셀 이탈 시 CommitEdit로 1회 보낸다. *@
                <input class="quro-editor" value="@Grid.EditText(RowKey, col)" data-mask="@col.Mask" />
                @if (PickerOpen)
                {
                    @* 선택 목록 (Addendum A-17): 고르면 바로 확정. 편집 중인 셀 하나에만 있다. *@
                    <div class="quro-picker">
                        @if (col.Type == CellType.Date)
                        {
                            @* 달력은 quro-grid.js가 그린다 (A-67). 달을 넘기는 동안 서버 호출이 없고, 고른 날짜만 PickDate로 1회 *@
                            <div class="quro-calendar" data-iso="@Grid.PickerIso" data-culture="@Grid.EffectiveCulture.Name"
                                 data-firstday="@((int)Grid.EffectiveCulture.DateTimeFormat.FirstDayOfWeek)"></div>
                        }
                        else
                        {
                            @* 현재 값은 선택 표시만. 같은 항목을 다시 골라도 확정된다. 항목 클릭은 quro-grid.js가 받아 PickOption으로 1회 (R5) *@
                            var selected = Grid.PickerIndex(col);
                            var options = Grid.OptionsOf(col, RowKey) ?? [];
                            <ul class="quro-options" role="listbox">
                                @for (var o = 0; o < options.Count; o++)
                                {
                                    <li class="quro-option" role="option" data-index="@o" aria-selected="@(o == selected ? "true" : null)">@options[o].Text</li>
                                }
                            </ul>
                        }
                    </div>
                }
            }
            else if (col.Type == CellType.Check)
            {
                <span class="quro-check" role="checkbox" aria-checked="@(Grid.IsChecked(RowKey, col) ? "true" : "false")"></span>
            }
            else if (col.Type == CellType.Image)
            {
                @if (Grid.ImageUrl(RowKey, col) is { } url)
                {
                    @* the click is received by quro-grid.js on the grid (R5) and sent once as ClickCell *@
                    <img class="quro-image" src="@url" alt="@Grid.ImageAlt(RowKey, col)" />
                }
            }
            else if (col.Type == CellType.Button)
            {
                <span class="quro-button" role="button">@Grid.Text(col.TextKey ?? "")</span>
            }
            else
            {
                @Grid.DisplayText(RowKey, col)
            }
        </div>
    }
</div>

@code {
    private (int Revision, int Epoch, int RowIndex, string? EditingField, bool PickerOpen)? _rendered;

    [Parameter, EditorRequired] public QuroGrid<TItem> Grid { get; set; } = default!;
    [Parameter, EditorRequired] public int RowKey { get; set; }
    [Parameter] public int RowIndex { get; set; }
    [Parameter] public int Revision { get; set; }
    [Parameter] public int Epoch { get; set; }
    [Parameter] public string? EditingField { get; set; }
    [Parameter] public bool PickerOpen { get; set; }

    /// <summary>행 단위 렌더 (R4): 행 리비전·편집 셀·선택 목록·위치·그리드 epoch가 바뀐 행만 다시 그린다.</summary>
    protected override bool ShouldRender()
    {
        var now = (Revision, Epoch, RowIndex, EditingField, PickerOpen);
        if (_rendered == now)
            return false;
        _rendered = now;
        return true;
    }

    // 첫 렌더는 ShouldRender를 거치지 않으므로 여기서 기록한다.
    protected override void OnInitialized() => _rendered = (Revision, Epoch, RowIndex, EditingField, PickerOpen);

    private static string MarkClass(string cls, CellMark? mark) => mark?.Level switch
    {
        CellMarkLevel.Error => cls + " quro-mark-error",
        CellMarkLevel.Warning => cls + " quro-mark-warning",
        _ => cls,
    };
}
