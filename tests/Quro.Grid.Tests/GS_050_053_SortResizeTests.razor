@inherits GridTestContext

@code {
    // GS-050 (정렬) · GS-053 (컬럼 리사이즈) 그리드 쪽 (Addendum A-22·A-23)
    // 헤더 클릭·경계 드래그는 quro-grid.js가 받아 Sort·ColumnResized를 부른다 (E2E에서 확인).

    private static readonly CultureInfo En = new("en-US");

    private static readonly ComboOption[] Units = [new("EA", "Piece"), new("BOX", "Box"), new("KG", "Kilogram")];

    private IRenderedComponent<QuroGrid<PoLine>> RenderGrid(QuroDataSet<PoLine> ds, int frozen = 0,
        EventCallback<SortChangedArgs> onSort = default, EventCallback<ColumnResizedArgs> onResized = default) =>
        Render<QuroGrid<PoLine>>(@<QuroGrid DataSet="ds" Culture="En" FrozenColumns="frozen"
                                            OnSortChanged="onSort" OnColumnResized="onResized">
                                     <QuroColumn Field="ItemCode" HeaderKey="mm.item.code" Width="100" />
                                     <QuroColumn Field="Qty" HeaderKey="mm.qty" Type="CellType.Number" Width="80" />
                                     <QuroColumn Field="Unit" HeaderKey="mm.unit" Type="CellType.Combo" Options="Units" />
                                     <QuroColumn Field="DueDate" HeaderKey="mm.due_date" Type="CellType.Date" />
                                     <QuroColumn Field="Detail" HeaderKey="mm.detail" Type="CellType.Button" TextKey="mm.detail.open" />
                                 </QuroGrid>);

    private static int[] Rendered(IRenderedComponent<QuroGrid<PoLine>> cut) =>
        cut.FindAll("[role=row][data-row]").Select(r => int.Parse(r.GetAttribute("data-row")!)).ToArray();

    private static string? AriaSort(IRenderedComponent<QuroGrid<PoLine>> cut, string field) =>
        cut.Find($"[role=columnheader][data-field={field}]").GetAttribute("aria-sort");

    /// <summary>수량 10·5·3 (키 1·2·3), 단위 BOX·EA·BOX, 납기 없음·11-05·11-01</summary>
    private static QuroDataSet<PoLine> Lines()
    {
        var ds = new QuroDataSet<PoLine>();
        ds.Load(
        [
            new PoLine { ItemCode = "A1001", Qty = 10m, Unit = "BOX" },
            new PoLine { ItemCode = "A1002", Qty = 5m, Unit = "EA", DueDate = new DateOnly(2026, 11, 5) },
            new PoLine { ItemCode = "A1003", Qty = 3m, Unit = "BOX", DueDate = new DateOnly(2026, 11, 1) },
        ]);
        return ds;
    }

    /// <summary>GS-050: 헤더 클릭 — 오름 → 내림 → 해제 (A-22). 해제하면 조회 순서. OnSortChanged 매번</summary>
    [Fact]
    public async Task GS_050_HeaderClick_CyclesAscDescNone()
    {
        var ds = Lines();
        var (r1, r2, r3) = (ds.RowKeys[0], ds.RowKeys[1], ds.RowKeys[2]);
        var events = new List<IReadOnlyList<SortColumn>>();
        var cut = RenderGrid(ds, onSort: EventCallback.Factory.Create<SortChangedArgs>(this, e => events.Add(e.Sort)));

        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: false));
        Assert.Equal([r3, r2, r1], Rendered(cut));
        Assert.Equal("ascending", AriaSort(cut, "Qty"));

        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: false));
        Assert.Equal([r1, r2, r3], Rendered(cut));
        Assert.Equal("descending", AriaSort(cut, "Qty"));

        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: false));
        Assert.Equal([r1, r2, r3], Rendered(cut));
        Assert.Null(AriaSort(cut, "Qty"));
        Assert.Empty(cut.Instance.SortColumns);

        Assert.Equal(3, events.Count);
        Assert.Equal([new SortColumn("Qty", SortDirection.Ascending)], events[0]);
        Assert.Equal([new SortColumn("Qty", SortDirection.Descending)], events[1]);
        Assert.Empty(events[2]);
        Assert.Equal([r1, r2, r3], ds.RowKeys);   // 화면 순서만 바뀐다. DataSet 순서·상태는 그대로
        Assert.False(ds.HasChanges);
    }

    /// <summary>GS-050: Shift+클릭 — 2차 정렬 추가, 헤더에 방향과 순번</summary>
    [Fact]
    public async Task GS_050_ShiftClick_AddsSecondarySort()
    {
        var ds = Lines();
        var (r1, r2, r3) = (ds.RowKeys[0], ds.RowKeys[1], ds.RowKeys[2]);
        var cut = RenderGrid(ds);

        await cut.InvokeAsync(() => cut.Instance.Sort("Unit", additive: false));    // Box(1·3), Piece(2)
        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: true));      // 같은 단위 안에서 수량 오름
        Assert.Equal([r3, r1, r2], Rendered(cut));

        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: true));      // 2차만 내림으로
        Assert.Equal([r1, r3, r2], Rendered(cut));
        Assert.Equal([new SortColumn("Unit", SortDirection.Ascending), new SortColumn("Qty", SortDirection.Descending)],
            cut.Instance.SortColumns);
        Assert.Equal("1", cut.Find("[role=columnheader][data-field=Unit] .quro-sort").GetAttribute("data-order"));
        Assert.Equal("2", cut.Find("[role=columnheader][data-field=Qty] .quro-sort").GetAttribute("data-order"));

        await cut.InvokeAsync(() => cut.Instance.Sort("ItemCode", additive: false)); // Shift 없이 → 그 컬럼만
        Assert.Equal([new SortColumn("ItemCode", SortDirection.Ascending)], cut.Instance.SortColumns);
        Assert.Null(AriaSort(cut, "Unit"));
    }

    /// <summary>GS-050: Combo는 표시 명칭, Date는 값 순서. 빈 값은 오름차순에서 맨 앞</summary>
    [Fact]
    public async Task GS_050_ComboByText_NullsFirst()
    {
        var ds = Lines();
        var (r1, r2, r3) = (ds.RowKeys[0], ds.RowKeys[1], ds.RowKeys[2]);
        ds.SetValue(r3, "Unit", "KG");                                   // BOX·EA·KG = Box·Piece·Kilogram
        var cut = RenderGrid(ds);

        await cut.InvokeAsync(() => cut.Instance.Sort("Unit", additive: false));
        Assert.Equal([r1, r3, r2], Rendered(cut));                       // 코드 순이면 1, 2, 3

        await cut.InvokeAsync(() => cut.Instance.Sort("DueDate", additive: false));
        Assert.Equal([r1, r3, r2], Rendered(cut));                       // 없음, 11-01, 11-05
    }

    /// <summary>GS-050: 정렬 중 값을 고쳐도 위치 유지 (A-22). 추가 행은 넣은 자리에</summary>
    [Fact]
    public async Task GS_050_EditAndAdd_KeepPositions()
    {
        var ds = Lines();
        var (r1, r2, r3) = (ds.RowKeys[0], ds.RowKeys[1], ds.RowKeys[2]);
        var cut = RenderGrid(ds);
        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: false));   // 3, 2, 1

        await cut.InvokeAsync(() => cut.Instance.CommitEdit(r3, "Qty", "99"));
        Assert.Equal([r3, r2, r1], Rendered(cut));

        var below = await cut.InvokeAsync(() => cut.Instance.AddRow(afterRowKey: r2));
        var end = await cut.InvokeAsync(() => cut.Instance.AddRow());
        var copies = await cut.InvokeAsync(() => cut.Instance.CopyRows([r3]));
        Assert.Equal([r3, copies[0], r2, below, r1, end], Rendered(cut));

        await cut.InvokeAsync(() => cut.Instance.DeleteRows([below]));             // Inserted 행 삭제 = 목록에서 제거
        Assert.Equal([r3, copies[0], r2, r1, end], Rendered(cut));
    }

    /// <summary>GS-050: 정렬 중 붙여넣기는 화면 순서대로 채운다</summary>
    [Fact]
    public async Task GS_050_Paste_FollowsSortedOrder()
    {
        var ds = Lines();
        var (r1, r2, r3) = (ds.RowKeys[0], ds.RowKeys[1], ds.RowKeys[2]);
        var cut = RenderGrid(ds);
        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: false));   // 3, 2, 1

        await cut.InvokeAsync(() => cut.Instance.Paste(r3, "Qty", [["7"], ["8"]]));

        Assert.Equal(7m, ds.GetValue(r3, "Qty"));
        Assert.Equal(8m, ds.GetValue(r2, "Qty"));
        Assert.Equal(10m, ds.GetValue(r1, "Qty"));
    }

    /// <summary>GS-050: 다시 조회(Load)하면 현재 정렬로 다시 정렬한다</summary>
    [Fact]
    public async Task GS_050_Reload_ReappliesSort()
    {
        var ds = Lines();
        var cut = RenderGrid(ds);
        await cut.InvokeAsync(() => cut.Instance.Sort("Qty", additive: false));

        ds.Load([new PoLine { ItemCode = "X", Qty = 9m }, new PoLine { ItemCode = "Y", Qty = 1m }]);
        await cut.InvokeAsync(() => cut.Instance.Refresh());

        Assert.Equal([ds.RowKeys[1], ds.RowKeys[0]], Rendered(cut));
    }

    /// <summary>GS-050: 앱에서 정렬 지정·해제 (SetSort / ClearSort). Button 컬럼은 정렬하지 않는다</summary>
    [Fact]
    public async Task GS_050_SetSort_ClearSort_ButtonIgnored()
    {
        var ds = Lines();
        var (r1, r2, r3) = (ds.RowKeys[0], ds.RowKeys[1], ds.RowKeys[2]);
        var events = 0;
        var cut = RenderGrid(ds, onSort: EventCallback.Factory.Create<SortChangedArgs>(this, () => events++));

        await cut.InvokeAsync(() => cut.Instance.SetSort([new SortColumn("Qty", SortDirection.Ascending)]));
        Assert.Equal([r3, r2, r1], Rendered(cut));

        await cut.InvokeAsync(() => cut.Instance.Sort("Detail", additive: false));
        Assert.Equal([new SortColumn("Qty", SortDirection.Ascending)], cut.Instance.SortColumns);

        await cut.InvokeAsync(() => cut.Instance.ClearSort());
        Assert.Equal([r1, r2, r3], Rendered(cut));
        Assert.Equal(0, events);   // 앱이 바꾼 정렬은 알리지 않는다 (사용자 조작만)
    }

    // ── GS-053 ──

    private static string Style(IRenderedComponent<QuroGrid<PoLine>> cut, string selector) =>
        cut.Find(selector).GetAttribute("style") ?? "";

    /// <summary>GS-053: 헤더마다 리사이즈 손잡이 (드래그는 JS)</summary>
    [Fact]
    public void GS_053_Headers_HaveResizeHandle()
    {
        var cut = RenderGrid(Lines());

        Assert.Equal(5, cut.FindAll("[role=columnheader] .quro-resize").Count);
    }

    /// <summary>GS-053: 드래그 완료(호출 1회) → 헤더·본문 너비 반영, OnColumnResized 1회</summary>
    [Fact]
    public async Task GS_053_ColumnResized_SetsWidth_RaisesEvent()
    {
        var ds = Lines();
        var events = new List<ColumnResizedArgs>();
        var cut = RenderGrid(ds, onResized: EventCallback.Factory.Create<ColumnResizedArgs>(this, e => events.Add(e)));

        await cut.InvokeAsync(() => cut.Instance.ColumnResized("Qty", 150));

        Assert.Contains("width:150px", Style(cut, "[role=columnheader][data-field=Qty]"));
        Assert.Contains("width:150px", Style(cut, $"[role=row][data-row='{ds.RowKeys[0]}'] [data-field=Qty]"));
        var e = Assert.Single(events);
        Assert.Equal(("Qty", 150), (e.Field, e.Width));
    }

    /// <summary>GS-053: 최소 너비 40px (A-23)</summary>
    [Fact]
    public async Task GS_053_MinWidth()
    {
        var cut = RenderGrid(Lines());

        await cut.InvokeAsync(() => cut.Instance.ColumnResized("Qty", 10));

        Assert.Contains("width:40px", Style(cut, "[role=columnheader][data-field=Qty]"));
    }

    /// <summary>GS-053: 고정 열 너비가 바뀌면 다음 고정 열 위치도 따라간다</summary>
    [Fact]
    public async Task GS_053_FrozenOffsets_Follow()
    {
        var cut = RenderGrid(Lines(), frozen: 2);

        await cut.InvokeAsync(() => cut.Instance.ColumnResized("ItemCode", 130));

        Assert.Contains("left:130px", Style(cut, "[role=columnheader][data-field=Qty]"));
    }
}
