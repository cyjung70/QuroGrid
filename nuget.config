<?xml version="1.0" encoding="utf-8"?>
<!--
  이 저장소는 nuget.org만 사용한다.
  사용자/머신 수준 피드(상용 피드, 로컬 오프라인 소스 등)를 상속하지 않도록 clear 한다.
  새 의존성은 MIT 호환 라이선스만 허용 (GPL 계열·상용 금지, Addendum A-41).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
